YOUTUBE_API_KEY=
API_HOST=127.0.0.1
API_PORT=8000
VANMUSIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,http://127.0.0.1:5000,http://localhost:5000,https://vanmusic.web.app,https://wedamnhac.web.app,https://wedamnhac.firebaseapp.com
VANMUSIC_INTEGRATION_KEY=
REQUIRE_INTEGRATION_KEY=false

# ---- Module Admin / Thống kê / Bình luận YouTube (gộp chung backend) ----
# Boss đăng nhập ở đầu web (bossvan) là vào thẳng Admin; backend nhận mật khẩu Boss mặc định van123.
# Đổi mật khẩu Boss: đặt VM_BOSS_PASSWORD (và đổi cùng giá trị ở index.html).
VM_BOSS_PASSWORD=
VM_ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên dài để ký token Admin (nếu bỏ trống, token mất hiệu lực mỗi lần backend khởi động lại)
VM_ADMIN_TOKEN_SECRET=
# Lưu thống kê: memory = bộ nhớ tạm (local). Để trống + điền Firebase bên dưới để lưu lâu dài.
VM_STORE=memory
FIREBASE_CREDENTIALS_JSON=
VM_TZ_OFFSET_HOURS=7
